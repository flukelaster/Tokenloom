{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": ["@figma/plugin-typings"]
  },
  "include": [
    "src/plugin/**/*.ts",
    "src/shared/**/*.ts",
    "packages/**/*.ts",
    "libraries/**/*.ts",
    "libraries/**/*.json"
  ],
  "exclude": ["node_modules", "dist", "src/ui"]
}
