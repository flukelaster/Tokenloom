{
  "name": "tokenloom-ds-forge",
  "version": "0.1.0",
  "description": "DS Forge — Open-source deterministic Figma Design System Generator Plugin with 3-tier Variables, Propstar-style 2D Variant Matrices, Live Documentation, and Three-Way Non-Destructive Updates",
  "license": "MIT",
  "author": "flukelaster",
  "homepage": "https://github.com/flukelaster/Tokenloom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flukelaster/Tokenloom.git"
  },
  "bugs": {
    "url": "https://github.com/flukelaster/Tokenloom/issues"
  },
  "keywords": [
    "figma",
    "figma-plugin",
    "design-system",
    "design-tokens",
    "dtcg",
    "figma-variables",
    "propstar",
    "shadcn-ui",
    "ant-design",
    "material-ui",
    "carbon-design-system"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "scripts": {
    "dev:ui": "vite --config vite.ui.config.ts",
    "build:ui": "vite build --config vite.ui.config.ts",
    "build:plugin": "node scripts/build-plugin.mjs",
    "build": "pnpm run build:ui && pnpm run build:plugin",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.plugin.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "audit:packages": "tsx scripts/audit-packages.ts",
    "check:release": "tsx scripts/release-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "verify": "pnpm run typecheck && pnpm run audit:packages && pnpm run test && pnpm run build && pnpm run check:release"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.142.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.13.9",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.25.0",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vite": "6.2.0",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "3.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
